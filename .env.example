# --- LLM ---
ANTHROPIC_API_KEY=
MODEL_JUDGE=claude-opus-5-5
MODEL_EXTRACT=claude-sonnet-5-5
MODEL_CLASSIFY=claude-haiku-5-5
MONTHLY_LLM_BUDGET_INR=5000
USD_TO_INR=88

# --- Google ---
GOOGLE_PLACES_API_KEY=
# Set true only after you've read the Places caching terms and confirmed your use case is allowed
PLACES_DISCOVERY_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/google/callback
YOUTUBE_API_KEY=

# --- Security ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Generate: python -m app.cli hash-password
ADMIN_PASSWORD_HASH=
# Set only on a backend served through the private Sites gateway.
SITES_ORIGIN_TOKEN=

# --- Sending & compliance ---
SEND_ENABLED=false
ALLOW_EU_UK=false
DAILY_CAP_EMAIL=15
HOURLY_CAP_EMAIL=5
MIN_GAP_SECONDS_EMAIL=180
DAILY_CAP_HANDOFF=25
CONTACT_LOCK_DAYS=90
RAW_RETENTION_DAYS=30
SEND_WINDOW=10:00-18:00
TIMEZONE=Asia/Kolkata
SENDER_NAME=
SENDER_EMAIL=
SENDER_CONTACT_ADDRESS=
DEFAULT_PHONE_REGION=IN

# --- Website fetcher ---
FETCH_USER_AGENT=ProofFirstOutreachBot/1.0 (+mailto:you@example.com)

# --- Meta inbound (Phase 6, needs app review) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_INBOUND_ENABLED=false
META_GRAPH_VERSION=v21.0

# --- Storage ---
DATABASE_URL=sqlite:///./data/outreach.db
UPLOAD_DIR=./data/uploads
JOBS_ENABLED=true
